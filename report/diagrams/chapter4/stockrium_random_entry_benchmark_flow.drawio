        <mxCell id="re-pipeline-return" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=20;fontStyle=1;spacing=8;" value="Full-pipeline&lt;br&gt;total return" vertex="1"><mxGeometry x="1320" y="410" width="210" height="80" as="geometry" /></mxCell>
        <mxCell id="re-result" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=20;fontStyle=1;spacing=8;" value="Pipeline percentile rank&lt;br&gt;and random-entry p-value" vertex="1"><mxGeometry x="1600" y="220" width="270" height="100" as="geometry" /></mxCell>
        <mxCell id="re-e1" edge="1" parent="1" source="re-stock" target="re-sample" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=2;"><mxGeometry relative="1" as="geometry" /></mxCell>
