  <diagram id="stockrium-random-entry-flow" name="Random-Entry Benchmark Flow">
    <mxGraphModel dx="1900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="re-stock" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=21;fontStyle=1;spacing=8;" value="Historical stock&lt;br&gt;OHLCV data" vertex="1"><mxGeometry x="20" y="100" width="220" height="90" as="geometry" /></mxCell>
        <mxCell id="re-count" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=20;fontStyle=1;spacing=8;" value="Completed full-pipeline&lt;br&gt;trade count" vertex="1"><mxGeometry x="20" y="350" width="240" height="90" as="geometry" /></mxCell>
