        <mxCell id="re-simulation" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0df;strokeColor=#d79b00;strokeWidth=2;fontSize=18;fontStyle=1;spacing=8;" value="Next-open simulation&lt;br&gt;fixed 20-candle hold;&lt;br&gt;0.15% cost per side;&lt;br&gt;no recommendation boundaries" vertex="1"><mxGeometry x="710" y="200" width="290" height="140" as="geometry" /></mxCell>
        <mxCell id="re-repeat" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4e8;strokeColor=#82b366;strokeWidth=2;fontSize=22;fontStyle=1;spacing=8;" value="Repeat&lt;br&gt;1,000 times" vertex="1"><mxGeometry x="1060" y="225" width="190" height="90" as="geometry" /></mxCell>
