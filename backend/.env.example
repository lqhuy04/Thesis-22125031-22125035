APP_NAME=Thesis Authentication API
VERSION=1.0.0
DEBUG=True

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here
# Connection string Postgres (Supabase → Project Settings → Database → Connection string).
# Dùng cho LangGraph PostgresSaver lưu lịch sử chat. Nên dùng Session pooler (port 5432).
SUPABASE_DB_URL=postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:5432/postgres
# Dedicated PostgreSQL role with SELECT only on approved market-data tables.
CHATBOT_READONLY_DB_URL=postgresql://chatbot_reader:your-password@aws-0-region.pooler.supabase.com:5432/postgres

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
RESET_TOKEN_EXPIRATION_MINUTES=30

# Redis
REDIS_URL=redis://localhost:6379/0

# Email — Resend HTTP API (BẮT BUỘC trên production/Railway vì SMTP ports bị chặn)
# Lấy API key tại https://resend.com/api-keys
# FROM_EMAIL phải thuộc domain đã verify trên Resend, hoặc dùng onboarding@resend.dev để test.
# Để trống RESEND_API_KEY -> chạy development mode (chỉ in OTP ra console).
RESEND_API_KEY=re_your_api_key
FROM_EMAIL=noreply@yourapp.com

# SMTP (legacy/unused — Railway chặn outbound 25/465/587, giữ lại để tham khảo)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# OAuth Configuration
# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Facebook OAuth
FACEBOOK_APP_ID=your_facebook_app_id_here
FACEBOOK_APP_SECRET=your_facebook_app_secret_here

# Frontend
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# CORS — origin được phép gọi từ trình duyệt (web admin / Expo web), cách nhau bởi dấu phẩy.
# App mobile không cần CORS. Production: thay bằng domain admin thật, ví dụ https://admin.stockrium.com
CORS_ORIGINS=http://localhost:8081,http://localhost:3000
MAX_REQUEST_BODY_BYTES=1048576

# AI providers
# Analysis v2, admin analysis, and backtest pipeline
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Chatbot pipeline (kept on OpenAI)
OPENAI_API_KEY=your-openai-api-key

# Chatbot API access key (required in request header x-chatbot-key)
CHATBOT_API_KEY=your-private-chatbot-key-here

# SSI FC Data API Configuration
# Get your credentials from: https://iboard.ssi.com.vn/support/api-service/management
SSI_CONSUMER_ID=your_ssi_consumer_id_here
SSI_CONSUMER_SECRET=your_ssi_consumer_secret_here
SSI_AUTH_TYPE=Bearer
SSI_API_URL=https://fc-data.ssi.com.vn/
SSI_STREAM_URL=https://fc-datahub.ssi.com.vn/
